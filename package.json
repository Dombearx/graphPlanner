{
  "name": "graphplanner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Planer zadan w formie grafu zaleznosci",
  "scripts": {
    "dev": "concurrently -n serwer,klient -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
